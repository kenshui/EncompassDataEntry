ENCOMPASS_INSTANCE=customer-instance
ENCOMPASS_SMART_CLIENT_USER=api-user@example.com
ENCOMPASS_SMART_CLIENT_PASSWORD=change-me
ENCOMPASS_CLIENT_ID=your-client-id
ENCOMPASS_CLIENT_SECRET=your-client-secret
ENCOMPASS_API_SERVER=https://api.elliemae.com

# Optional endpoint overrides for customer-specific Encompass deployments.
ENCOMPASS_TOKEN_PATH=/oauth2/v1/token
ENCOMPASS_LOANS_PATH=/encompass/v3/loans
ENCOMPASS_ATTACHMENTS_PATH_TEMPLATE=/encompass/v3/loans/{loan_id}/attachments
ENCOMPASS_ATTACHMENT_DOWNLOAD_PATH_TEMPLATE=/encompass/v3/loans/{loan_id}/attachments/content
ENCOMPASS_ATTACHMENT_DOWNLOAD_BODY_FIELD=attachmentId
ENCOMPASS_LOAN_UPDATE_PATH_TEMPLATE=/encompass/v3/loans/{loan_id}

AGENT_DATABASE_PATH=data/encompass_ai_agent.sqlite3
AGENT_DOWNLOAD_DIR=data/downloads
AGENT_LOG_PATH=data/agent-events.jsonl
AGENT_FIELD_MAPPING_PATH=config/field_mapping.example.json
AGENT_LOOKBACK_DAYS=31
AGENT_DRY_RUN=true
LOG_LEVEL=INFO

# Optional: set to openai or leave as regex.
AI_PROVIDER=regex
AI_API_KEY=
AI_MODEL=gpt-4o-mini
